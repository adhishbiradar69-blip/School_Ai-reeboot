# Backend API URL — REQUIRED for production deploys (Vercel, Netlify, etc.)
# Locally: leave unset (defaults to http://127.0.0.1:8000)
# On Vercel: set to your deployed backend URL, e.g. https://schoolai-api.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# Backend-only env vars (set on your backend host, NOT in Vercel)
# GROQ_API_KEY=your-groq-api-key-here
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
